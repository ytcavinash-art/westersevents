NODE_ENV=production
BACKEND_ONLY=true
HOST=127.0.0.1
BASE_URL=https://api.westers.in
ALLOWED_ORIGINS=https://westers.in,https://www.westers.in
# Replace CPANEL_USER with your cPanel username. This path must be private.
DATABASE_PATH=/home/CPANEL_USER/westers-data/westers.db
ADMIN_EMAIL=admin@westers.in
ADMIN_PASSWORD=
JWT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
RESEND_API_KEY=
FROM_EMAIL=
BROCHURE_URL=
# TRUST_PROXY_HOPS: set only after the host confirms its proxy topology.
