PORT=3000
BASE_URL=http://localhost:3000

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp sender, e.g. whatsapp:+14155238886 for sandbox
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Approved WhatsApp Content Template SID, e.g. HX...
TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email via Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=Westers Events <events@your-verified-domain.com>

# Admin
ADMIN_EMAIL=admin@westers.in
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Optional public brochure URL if you don't want attachment
BROCHURE_URL=https://westers.in/westers-brochure.pdf

# Deployment (set in cPanel environment, not public_html)
NODE_ENV=production
HOST=127.0.0.1
ALLOWED_ORIGINS=https://westers.in
# Absolute website document root and private persistent database path:
# WEBSITE_ROOT=/home/CPANEL_USER/public_html
# DATABASE_PATH=/home/CPANEL_USER/westers-data/westers.db
# Only set after confirming the actual number of trusted reverse proxies:
# TRUST_PROXY_HOPS=1
